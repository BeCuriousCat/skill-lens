{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lens.dev/schema/instruction-analysis.v0.1.json",
  "title": "Graph-bound instruction interpretation, not runtime proof",
  "type": "object",
  "required": [
    "schema",
    "caseId",
    "revision",
    "graphSha256",
    "title",
    "identity",
    "summary",
    "scopeNote",
    "stages",
    "prompts",
    "audiences",
    "illustrations",
    "unknowns"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "skill-lens.instruction-analysis.v0.1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "graphSha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scopeNote": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "instruction",
          "interpretation",
          "evidenceNodeIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "evidenceNodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 7
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "evidenceNodeIds"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidenceNodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "label",
          "instruction",
          "evidenceNodeIds"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "evidenceNodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "kind",
                "instruction",
                "evidenceNodeIds",
                "sourceQuote"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "pattern": "focus|language|analogy|tone|depth|structure"
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceNodeIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sourceQuote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "illustrations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "audience",
          "input",
          "output",
          "rationale",
          "evidenceNodeIds"
        ],
        "properties": {
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidenceNodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question",
          "detail"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
