{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-lens.evidence-question-slices.v0.1",
  "type": "object",
  "required": ["schema", "caseId", "revision", "slices"],
  "properties": {
    "schema": {"const": "skill-lens.evidence-question-slices.v0.1"},
    "caseId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "budgetChars": {"type": "integer", "minimum": 1},
    "maxNodes": {"type": "integer", "minimum": 1},
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "slice"],
        "properties": {
          "questionId": {"type": "string", "minLength": 1},
          "slice": {
            "type": "object",
            "required": ["schema", "caseId", "revision", "selected", "edges", "selectedNodeIds"],
            "properties": {
              "schema": {"const": "skill-lens.evidence-question-slice.v0.1"},
              "caseId": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "budgetChars": {"type": "integer", "minimum": 1},
              "usedChars": {"type": "integer", "minimum": 0},
              "maxNodes": {"type": "integer", "minimum": 1},
              "selectedNodeIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "selected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["nodeId", "evidenceId", "source", "quote"],
                  "properties": {
                    "nodeId": {"type": "string", "minLength": 1},
                    "evidenceId": {"type": "string", "minLength": 1},
                    "source": {"type": "object"},
                    "quote": {"type": "string"}
                  },
                  "additionalProperties": true
                }
              },
              "edges": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
