{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lens.dev/schema/graph-patch.v0.1.json",
  "title": "Skill Lens GraphPatch v0.1",
  "type": "object",
  "required": ["schema", "provider", "caseId", "revision", "nodes", "edges", "evidence", "diagnostics"],
  "properties": {
    "schema": {"const": "skill-lens.graph-patch.v0.1"},
    "provider": {"$ref": "#/$defs/provider"},
    "caseId": {"type": "string", "minLength": 1},
    "revision": {"$ref": "#/$defs/revision"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider": {
      "type": "object", "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "attributes": {"type": "object", "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": true},
    "node": {
      "type": "object", "required": ["id", "type", "label", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}, "attributes": {"$ref": "#/$defs/attributes"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object", "required": ["id", "from", "to", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "attributes": {"$ref": "#/$defs/attributes"}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object", "required": ["id", "sourceType", "source", "quote", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "sourceType": {"enum": ["doc", "code", "trace", "inference"]},
        "source": {"$ref": "#/$defs/source"}, "quote": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}, "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object", "required": ["revision", "path", "lines"],
      "properties": {
        "repository": {"type": "string", "minLength": 1}, "revision": {"$ref": "#/$defs/revision"},
        "path": {"type": "string", "minLength": 1}, "lines": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object", "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "nodeIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "edgeIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
